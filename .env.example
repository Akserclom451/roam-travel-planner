# Server Configuration
PORT=3000
NODE_ENV=development

# Razorpay Sandbox Credentials (TEST MODE ONLY)
# Obtain test credentials from Razorpay Dashboard (Settings -> API Keys in Test Mode)
# Test Key ID must start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Optional Client Environment Variables
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=
